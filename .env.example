# ---------------------------------------------------------------------------
# CommunityHub environment variables
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Supabase project URL and public (anon / publishable) key.
# Local:      run `npx supabase status` after `npm run db:start`
# Production: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=http://127.0.0.1:55421
VITE_SUPABASE_ANON_KEY=

# Service role / secret key. ONLY used by scripts/seed-storage.mjs on your machine.
# Never expose it to the browser (no VITE_ prefix) and never set it in the frontend host.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: show the demo-account quick-fill on the sign-in page outside `npm run dev`
# (e.g. a private staging deploy that uses seed data). Leave unset in production.
# VITE_SHOW_DEMO_ACCOUNTS=true

# Optional: Playwright overrides
# E2E_BASE_URL=https://staging.example.org   # test a deployed app instead of starting `vite`
# E2E_PASSWORD=                              # password for the seeded test accounts
